# Wine 11.19 built for Apple Silicon, with FEX running x86_64 (ARM64EC) and i386 (WoW64)
# code instead of Rosetta. Needs macOS 26.5 and a loader signed with the
# cross-architecture entitlement, see the arm64 part of build-wine.sh.
RUNTIME_ID=wine-11.19-arm64
RUNTIME_NAME="Wine 11.19 (Apple Silicon)"
ARCH=arm64
WINE_TAG=wine-11.19
WINE_COMMIT=455e3509b98a6919fd4ad1def4803e08c41c03b2
