# Wine 11.21 built for Apple Silicon, with FEX running x86_64 (ARM64EC) and i386 (WoW64)
# code instead of Rosetta. Needs macOS 26.5 and a loader signed with the
# cross-architecture entitlement, see the arm64 part of build-wine.sh.
RUNTIME_ID=wine-11.21-fex
RUNTIME_NAME="Wine 11.21 (Apple Silicon)"
ARCH=arm64
WINE_TAG=wine-11.21
WINE_COMMIT=2528aff26208257fdbf980666a4f0e66d47563ce
