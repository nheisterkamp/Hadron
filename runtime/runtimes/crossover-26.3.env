# CodeWeavers' Wine from the CrossOver 26.3 source release: Wine 11.0 with their Mac
# and game fixes. Built from the published source, so no CrossOver app or license.
RUNTIME_ID=crossover-26.3
RUNTIME_NAME="CrossOver Wine 26.3"
SOURCE_URL=https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
SOURCE_SHA256=ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872
SOURCE_SUBDIR=sources/wine
# Wine 11.0 cannot build lsteamclient, so it comes from the 11.15 runtime.
COMPONENTS_FROM=wine-11.15
