          }
        }
      }
    },
    "%@ is already listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereits aufgeführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure déjà dans la liste."
          }
        },
