    "Steam" : {
      "localizations" : {

      },
      "shouldTranslate" : false
    },
    "Steam at %@ isn't connected, so Hadron can't be removed from it. All other Hadron data is removed, except for Windows Games and prefixes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato, quindi Hadron non può esserne rimosso. Tutti gli altri dati di Hadron vengono rimossi, tranne i giochi Windows e i prefissi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接，因此无法从中移除 Hadron。其他所有 Hadron 数据都会被移除，但 Windows 游戏及游戏容器除外。"
          }
        }
      }
    },
    "Steam at %@ isn't connected." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接。"
          }
        }
      }
    },
    "Steam client updates are allowed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono consentiti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates are blocked." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono bloccati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已阻止 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates may break Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere Hadron inutilizzabile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Hadron 无法使用。"
          }
        }
      }
    },
    "Steam client updates may break Hadron. If you don't want to wait for Hadron to be updated to be compatible with future Steam versions at the cost of not getting updates to the Steam client, you can stop the Steam client from updating itself." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere Hadron inutilizzabile. Se non vuoi aspettare che Hadron venga aggiornato per le future versioni di Steam, puoi impedire al client Steam di aggiornarsi, rinunciando però ai suoi aggiornamenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Hadron 无法使用。你可以阻止 Steam 自动更新，避免等待 Hadron 适配新版本，但这也意味着无法及时获得 Steam 客户端的功能改进和安全更新。"
          }
        }
      }
    },
    "Steam could not be fully restored. Please run Repair Steam again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile ripristinare completamente Steam. Esegui di nuovo Ripara Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能完全恢复 Steam。请再次执行“修复 Steam”。"
          }
        }
      }
    },
    "Steam has a different copy of Hadron, installed by another account on this Mac. Update Hadron from that account, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha una copia diversa di Hadron, installata da un altro account su questo Mac. Aggiorna Hadron da quell'account, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中的另一份 Hadron 是由本机其他账户安装的。请使用该账户更新 Hadron，然后重试。"
          }
        }
      }
    },
    "Steam has not been set up for Hadron, and this account cannot change it. Install from the account that owns Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non è stato configurato per Hadron e questo account non può modificarlo. Installa dall'account a cui appartiene Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 尚未配置 Hadron，当前账户无权修改。请使用安装 Steam 的账户执行安装。"
          }
        }
      }
    },
    "Steam integration needs repair." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'integrazione con Steam va riparata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 集成需要修复。"
          }
        }
      }
    },
    "Steam is restored to its unmodified state and Hadron is removed, including the compatibility tool that lives inside the Steam folder. Windows games and Steam Play prefixes are not removed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam viene riportato allo stato originale e Hadron viene rimosso, compreso lo strumento di compatibilità nella cartella di Steam. I giochi Windows e i prefissi di Steam Play non vengono rimossi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会将 Steam 恢复为未修改的状态，并移除 Hadron（包括 Steam 文件夹内的兼容工具）。不会删除 Windows 游戏及 Steam Play 游戏容器。"
          }
        }
      }
    },
    "Steam is running" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è in esecuzione"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行"
          }
        }
      }
    },
    "Steam is running, please close Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è in esecuzione, chiudi Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行，请先关闭 Steam。"
          }
        }
      }
    },
    "Steam is set up to inject a different dylib. Please repair Steam before installing Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è configurato per caricare una dylib diversa. Ripara Steam prima di installare Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已配置为注入其他动态库。请先修复 Steam，再安装 Hadron。"
          }
        }
      }
    },
    "Steam not found." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non trovato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到 Steam。"
          }
        }
      }
    },
    "Steam restored to its original state." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam riportato allo stato originale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已恢复原状。"
          }
        }
      }
    },
    "Steam was installed by another account on this Mac. Only that account can modify it. Log in to macOS with that account to reinstall Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato installato da un altro account su questo Mac e solo quell'account può modificarlo. Accedi a macOS con quell'account per reinstallare Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 由这台 Mac 上的其他账户安装，只有该账户可以修改。请登录该账户，重新安装 Hadron。"
          }
        }
      }
    },
    "Steam was stopped, so start it again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato chiuso: riavvialo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已停止，请重新启动。"
          }
        }
      }
    },
    "Steam's installed dylib does not match this account's build record. Finish or repair its installation with the Hadron app that last installed it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dylib installata in Steam non corrisponde alla build registrata per questo account. Completa o ripara l'installazione con l'app Hadron che l'ha installata per ultima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中已安装的动态库与当前账户的版本记录不一致。请使用上次执行安装的 Hadron 应用完成或修复安装。"
          }
        }
      }
    },
