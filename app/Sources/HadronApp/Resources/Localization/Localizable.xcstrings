          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在列表中。"
          }
        }
      }
    },
    "%@ is already there. Remove it to download the runtime again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereits vorhanden. Entferne es, um die Runtime erneut herunterzuladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existe déjà. Supprimez-le pour télécharger de nouveau le runtime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già presente. Rimuovilo per scaricare di nuovo il runtime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已存在。如需重新下载该运行环境，请先将其移除。"
          }
        }
      }
    },
    "%@ is left from a rebuild that did not finish and may hold the only copy of the saves. Move it somewhere safe, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stammt von einer nicht abgeschlossenen Neuerstellung und enthält möglicherweise die einzige Kopie der Spielstände. Verschiebe es an einen sicheren Ort und versuche es dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ provient d'une reconstruction inachevée et contient peut-être la seule copie des parties sauvegardées. Déplacez-le en lieu sûr, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è rimasto da una ricostruzione non completata e potrebbe contenere l'unica copia dei salvataggi. Spostalo in un posto sicuro, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是上次未完成重建留下的文件，可能保存着唯一的游戏存档。请先将其移到安全位置，然后重试。"
          }
        }
      }
    },
