    "A game appears here once it has been started with a Hadron compatibility tool." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Spiel erscheint hier, sobald es mit einem Hadron-Kompatibilitätstool gestartet wurde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jeu apparaît ici dès qu'il a été lancé avec un outil de compatibilité Hadron."
