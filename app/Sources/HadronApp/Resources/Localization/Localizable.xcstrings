    },
    "Hadron could not download the files it needs from %@. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron konnte die benötigten Dateien nicht von %@ laden. Bitte versuche es später erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron n'a pas pu télécharger les fichiers nécessaires depuis %@. Veuillez réessayer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron non è riuscito a scaricare da %@ i file che gli servono. Riprova più tardi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron 无法从 %@ 下载所需文件。请稍后重试。"
          }
        }
      }
    },
    "Hadron could not reach %@'s servers. Please check your internet connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron konnte die Server von %@ nicht erreichen. Bitte prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron n'a pas pu joindre les serveurs de %@. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron non è riuscito a raggiungere i server di %@. Controlla la connessione a internet e riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron 无法连接 %@ 服务器。请检查网络连接，然后重试。"
          }
        }
      }
    },
    "Hadron does not run %@ with Winetricks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron führt %@ nicht mit Winetricks aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron n'exécute pas %@ avec Winetricks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron non esegue %@ con Winetricks."
          }
