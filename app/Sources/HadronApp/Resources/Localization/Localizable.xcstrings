{
  "sourceLanguage" : "en",
  "strings" : {
    " with %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " con %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ vengono entrambi da %3$@ ma fissano hash diversi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ answered %lld for %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ answered %2$lld for %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha risposto %2$lld per %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 对 %3$@ 返回了 %2$lld。"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile copiare %@ fuori dal prefisso. Il prefisso è rimasto com'era e non è andato perso nulla. Controlla lo spazio libero e i permessi, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be read as a property list." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %@ come property list."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将 %@ 读取为属性列表。"
          }
        }
      }
    },
    "%@ could not be read. %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %1$@. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。%@"
          }
        }
      }
    },
    "%@ could not be signed. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile firmare %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法对 %@ 签名。"
          }
        }
      }
    },
    "%@ could not be unpacked. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile estrarre %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解压 %@。"
          }
        }
      }
    },
    "%@ could not be written. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scrivere %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 %@。"
          }
        }
      }
    },
    "%@ did not contain %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non conteneva %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中不包含 %@。"
          }
        }
      }
    },
    "%@ does not appear to have a prefix to back up." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non sembra avere un prefisso di cui fare il backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 似乎没有可备份的游戏容器。"
          }
        }
      }
    },
    "%@ does not hold Wine runtime %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not hold Wine runtime %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non contiene il runtime Wine %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中没有 Wine 运行环境 %2$@。"
          }
        }
      }
    },
    "%@ does not match the checksum Hadron expects, so it was not used." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde al checksum atteso da Hadron, quindi non è stato usato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 与 Hadron 预期的校验和不符，因此未被使用。"
          }
        }
      }
    },
    "%@ does not verify against its own signature. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde alla propria firma. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未通过自身签名验证。"
          }
        }
      }
    },
    "%@ failed with status %d." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d。"
          }
        }
      }
    },
    "%@ failed with status %d: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d): %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d：%@"
          }
        }
      }
    },
    "%@ has no D3DMetal DLLs." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non contiene DLL di D3DMetal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中没有 D3DMetal DLL。"
          }
        }
      }
    },
    "%@ has no prefix at %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non ha un prefisso in %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处没有游戏容器。"
          }
        }
      }
    },
    "%@ is already listed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già nell'elenco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在列表中。"
          }
        }
      }
    },
    "%@ is already there. Remove it to download the runtime again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già presente. Rimuovilo per scaricare di nuovo il runtime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已存在。如需重新下载该运行环境，请先将其移除。"
          }
        }
      }
    },
    "%@ is left from a rebuild that did not finish and may hold the only copy of the saves. Move it somewhere safe, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è rimasto da una ricostruzione non completata e potrebbe contenere l'unica copia dei salvataggi. Spostalo in un posto sicuro, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是上次未完成重建留下的文件，可能保存着唯一的游戏存档。请先将其移到安全位置，然后重试。"
          }
        }
      }
    },
    "%@ is not Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam。"
          }
        }
      }
    },
    "%@ is not a Hadron Wine runtime." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un runtime Wine di Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Hadron Wine 运行时。"
          }
        }
      }
    },
    "%@ is not a Windows program. Pick an exe, msi, bat or cmd file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un programma Windows. Scegli un file exe, msi, bat o cmd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Windows 程序。请选择 exe、msi、bat 或 cmd 文件。"
          }
        }
      }
    },
    "%@ is not a supported build. Supported: %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è una build supportata. Supportate: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持构建版本 %@。支持的版本：%@。"
          }
        }
      }
    },
    "%@ is not signed by Valve. Expected TeamIdentifier=%@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è firmato da Valve. Atteso TeamIdentifier=%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 并非由 Valve 签名。预期 TeamIdentifier=%@。"
          }
        }
      }
    },
    "%@ is not the Steam bundle. Expected Identifier=%@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è il bundle di Steam. Atteso Identifier=%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam 应用包。预期 Identifier=%@。"
          }
        }
      }
    },
    "%@ is not there, so there is nothing to install into." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non c'è, quindi non c'è niente in cui installare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在，无法安装。"
          }
        }
      }
    },
    "%@ is running. Quit the game first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione. Esci prima dal gioco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行。请先退出游戏。"
          }
        }
      }
    },
    "%@ names the package %@, which is not declared. Declared: %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ indica il pacchetto %2$@, che non è dichiarato. Dichiarati: %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 指定了未声明的软件包 %@。已声明：%@。"
          }
        }
      }
    },
    "%@ templates %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelli %1$@ %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 模板 %@"
          }
        }
      }
    },
    "%@ was last run by %@, which is no longer set up. Rebuild the prefix first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è stato avviato l'ultima volta con %2$@, che non è più configurato. Ricostruisci prima il prefisso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上次使用 %@ 运行，但该兼容工具已不可用。请先重建游戏容器。"
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@, %@ private size" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, dimensione %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，独占空间 %@"
          }
        }
      }
    },
    "%@.%@ is missing from the app's resources." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@.%2$@ manca dalle risorse dell'app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用资源中缺少 %@.%@。"
          }
        }
      }
    },
    "%@/%@ is missing" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ manca"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少 %@/%@"
          }
        }
      }
    },
    "%lld backups" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld backup"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个备份"
          }
        }
      }
    },
    "%lld of %lld MB, %lld%%" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld MB, %3$lld%%"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld di %2$lld MB, %3$lld%%"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld / %2$lld MB，%3$lld%%"
          }
        }
      }
    },
    "1 backup" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 backup"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 个备份"
          }
        }
      }
    },
    "A Steam client update may break Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aggiornamento del client Steam potrebbe rendere Hadron inutilizzabile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Hadron 无法使用。"
          }
        }
      }
    },
    "A game appears here once it has been started with a Hadron compatibility tool." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gioco compare qui dopo essere stato avviato con uno strumento di compatibilità di Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Hadron 兼容性工具启动游戏后，游戏会显示在这里。"
          }
        }
      }
    },
    "A game or Wine tool is running on build %@. Quit it before updating Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gioco o uno strumento di Wine è in esecuzione sulla build %@. Chiudilo prima di aggiornare Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有游戏或 Wine 工具正在使用构建版本 %@。请先退出，再更新 Hadron。"
          }
        }
      }
    },
    "A game or Wine tool is running. Quit it before updating Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gioco o uno strumento di Wine è in esecuzione. Chiudilo prima di aggiornare Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有游戏或 Wine 工具正在运行。请先退出，再更新 Hadron。"
          }
        }
      }
    },
    "A game or Wine tool is still running on build %@. Quit it first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gioco o uno strumento di Wine è ancora in esecuzione sulla build %@. Chiudilo prima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍有游戏或 Wine 工具正在使用构建版本 %@。请先退出。"
          }
        }
      }
    },
    "A newer Hadron build is installed. Use that build to update or repair the installed files." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È installata una build più recente di Hadron. Usa quella build per aggiornare o riparare i file installati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装较新的 Hadron 版本。请使用该版本更新或修复已安装的文件。"
          }
        }
      }
    },
    "A newer build is installed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È installata una build più recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装较新的版本。"
          }
        }
      }
    },
    "A prefix appears here once a Windows game has been launched through Hadron." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un prefisso compare qui dopo che un gioco Windows è stato avviato tramite Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Hadron 启动 Windows 游戏后，对应的游戏容器就会显示在这里。"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加"
          }
        }
      }
    },
    "Add D3DMetal" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi D3DMetal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 D3DMetal"
          }
        }
      }
    },
    "Add D3DMetal from Apple's Game Porting Toolkit or CrossOver on this Mac." : {
      "localizations" : {
        "it" : {
