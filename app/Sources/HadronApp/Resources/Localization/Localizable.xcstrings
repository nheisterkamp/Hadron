            "value" : "Steam 正在运行，请先关闭 Steam。"
          }
        }
      }
    },
    "Steam is set up to inject a different dylib. Please repair Steam before installing Hadron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ist so eingerichtet, dass eine andere dylib geladen wird. Bitte repariere Steam, bevor du Hadron installierst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam est configuré pour injecter une autre dylib. Réparez Steam avant d'installer Hadron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è configurato per caricare una dylib diversa. Ripara Steam prima di installare Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已配置为注入其他动态库。请先修复 Steam，再安装 Hadron。"
