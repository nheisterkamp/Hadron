    "Steam" : {
      "shouldTranslate" : false
    },
    "Steam at %@ isn't connected, so Hadron can't be removed from it. All other Hadron data is removed, except for Windows Games and prefixes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam unter %@ ist nicht verbunden, daher kann Hadron dort nicht entfernt werden. Alle anderen Hadron-Daten werden entfernt, außer Windows-Spielen und Präfixen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam à %@ n'est pas connecté, Hadron ne peut donc pas en être supprimé. Toutes les autres données de Hadron sont supprimées, sauf les jeux Windows et les préfixes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato, quindi Hadron non può esserne rimosso. Tutti gli altri dati di Hadron vengono rimossi, tranne i giochi Windows e i prefissi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接，因此无法从中移除 Hadron。其他所有 Hadron 数据都会被移除，但 Windows 游戏及游戏容器除外。"
          }
        }
      }
    },
    "Steam at %@ isn't connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam unter %@ ist nicht verbunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam à %@ n'est pas connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接。"
          }
        }
      }
    },
    "Steam client updates are allowed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam-Client-Updates sind erlaubt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour du client Steam sont autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono consentiti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates are blocked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
