    "Steam restored to its original state." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam wurde in den Originalzustand zurückversetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a été restauré dans son état d'origine."
          }
