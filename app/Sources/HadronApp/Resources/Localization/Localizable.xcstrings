      }
    },
    "%@ does not match the checksum Hadron expects, so it was not used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stimmt nicht mit der von Hadron erwarteten Prüfsumme überein und wurde daher nicht verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne correspond pas à la somme de contrôle attendue par Hadron et n'a donc pas été utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde al checksum atteso da Hadron, quindi non è stato usato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 与 Hadron 预期的校验和不符，因此未被使用。"
          }
        }
      }
    },
    "%@ does not verify against its own signature. " : {
      "localizations" : {
        "de" : {
