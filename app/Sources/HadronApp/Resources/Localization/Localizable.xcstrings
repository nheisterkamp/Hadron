    "Rebuilt %lld prefixes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Präfixe neu erstellt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld préfixes reconstruits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruiti %lld prefissi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建 %lld 个游戏容器。"
          }
        }
      }
    },
    "Rebuilt %lld prefixes. Each original is kept beside the game's prefix. Check that your saves are present in the games, then delete the backups to save space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Präfixe neu erstellt. Jedes Original liegt neben dem Präfix des Spiels. Prüfe, ob deine Spielstände in den Spielen vorhanden sind, und lösche dann die Backups, um Speicherplatz zu sparen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld préfixes reconstruits. Chaque original est conservé à côté du préfixe du jeu. Vérifiez que vos parties sauvegardées sont présentes dans les jeux, puis supprimez les sauvegardes pour libérer de l'espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruiti %lld prefissi. Ogni originale è conservato accanto al prefisso del gioco. Controlla che i salvataggi siano presenti nei giochi, poi elimina i backup per liberare spazio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建 %lld 个游戏容器。各原容器均保存在对应游戏容器旁。请先进入游戏确认存档正常，再删除备份以释放空间。"
          }
        }
      }
    },
    "Rebuilt the prefix for %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Präfix für %@ neu erstellt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préfixe de %@ reconstruit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruito il prefisso di %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建“%@”的游戏容器。"
          }
        }
      }
    },
    "Rebuilt the prefix for %@. The original is at %@. Check that your save is present in the game, then delete the backup to save space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Präfix für %1$@ neu erstellt. Das Original liegt unter %2$@. Prüfe, ob dein Spielstand im Spiel vorhanden ist, und lösche dann das Backup, um Speicherplatz zu sparen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préfixe de %1$@ reconstruit. L'original se trouve à %2$@. Vérifiez que votre partie sauvegardée est présente dans le jeu, puis supprimez la sauvegarde pour libérer de l'espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruito il prefisso di %1$@. L'originale è in %2$@. Controlla che il salvataggio sia presente nel gioco, poi elimina il backup per liberare spazio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建“%@”的游戏容器。原容器保存在 %@。请先进入游戏确认存档正常，再删除备份以释放空间。"
          }
        }
      }
    },
