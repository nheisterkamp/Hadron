    },
    "This can also fix issues where a game previously started/worked and does not work now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann auch Probleme beheben, wenn ein Spiel früher lief und jetzt nicht mehr funktioniert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut aussi corriger les cas où un jeu démarrait ou fonctionnait auparavant et ne fonctionne plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può anche risolvere i casi in cui un gioco prima si avviava/funzionava e ora non funziona più."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可能修复游戏之前能运行、现在却无法运行的问题。"
          }
        }
      }
    },
    "This copy of Hadron cannot repair Steam. Please reinstall Hadron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Hadron-Kopie kann Steam nicht reparieren. Bitte installiere Hadron neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de Hadron ne peut pas réparer Steam. Réinstallez Hadron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia di Hadron non può riparare Steam. Reinstalla Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hadron 副本无法修复 Steam。请重新安装 Hadron。"
          }
        }
      }
    },
    "This package needs its files downloaded by hand, which Hadron cannot do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This package needs its files downloaded by hand, which Hadron cannot do."
          }
        },
