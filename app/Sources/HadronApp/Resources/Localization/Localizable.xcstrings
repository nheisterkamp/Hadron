        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron 不会通过 Winetricks 运行 %@。"
          }
        }
      }
    },
    "Hadron has been partially removed, because Steam at %@ cannot be found. Delete that copy of Steam and reinstall it to fully remove Hadron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron wurde nur teilweise entfernt, weil Steam unter %@ nicht gefunden wurde. Lösche diese Steam-Kopie und installiere Steam neu, um Hadron vollständig zu entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron a été partiellement supprimé, car Steam est introuvable à %@. Supprimez cette copie de Steam et réinstallez-la pour supprimer complètement Hadron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron è stato rimosso solo in parte, perché Steam in %@ non si trova. Elimina quella copia di Steam e reinstallala per rimuovere del tutto Hadron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron 仅被部分移除，因为找不到位于 %@ 的 Steam。请删除该 Steam 并重新安装，以完全移除 Hadron。"
          }
        }
      }
    },
    "Hadron has been removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron wurde entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron a été supprimé."
          }
