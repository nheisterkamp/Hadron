{
  "sourceLanguage" : "en",
  "strings" : {
    " with %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ answered %lld for %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ answered %2$lld for %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 对 %3$@ 返回了 %2$lld。"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be read as a property list." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将 %@ 读取为属性列表。"
          }
        }
      }
    },
    "%@ could not be read. %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。%@"
          }
        }
      }
    },
    "%@ could not be signed. " : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法对 %@ 签名。"
          }
        }
      }
    },
    "%@ could not be unpacked. " : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解压 %@。"
          }
        }
      }
    },
    "%@ could not be written. " : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 %@。"
          }
        }
      }
    },
    "%@ did not contain %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中不包含 %@。"
          }
        }
      }
    },
    "%@ does not appear to have a prefix to back up." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 似乎没有可备份的游戏容器。"
          }
        }
      }
    },
    "%@ does not hold Wine runtime %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not hold Wine runtime %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中没有 Wine 运行环境 %2$@。"
          }
        }
      }
    },
    "%@ does not match the checksum Hadron expects, so it was not used." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 与 Hadron 预期的校验和不符，因此未被使用。"
          }
        }
      }
    },
    "%@ does not verify against its own signature. " : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未通过自身签名验证。"
          }
        }
      }
    },
    "%@ failed with status %d." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d。"
          }
        }
      }
    },
    "%@ failed with status %d: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d：%@"
          }
        }
      }
    },
    "%@ has no D3DMetal DLLs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中没有 D3DMetal DLL。"
          }
        }
      }
    },
    "%@ has no prefix at %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处没有游戏容器。"
          }
        }
      }
    },
    "%@ is already listed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在列表中。"
          }
        }
      }
    },
    "%@ is already there. Remove it to download the runtime again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已存在。如需重新下载该运行环境，请先将其移除。"
          }
        }
      }
    },
    "%@ is left from a rebuild that did not finish and may hold the only copy of the saves. Move it somewhere safe, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是上次未完成重建留下的文件，可能保存着唯一的游戏存档。请先将其移到安全位置，然后重试。"
          }
        }
      }
    },
    "%@ is not Steam." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam。"
          }
        }
      }
    },
    "%@ is not a Hadron Wine runtime." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Hadron Wine 运行时。"
          }
        }
      }
    },
    "%@ is not a Windows program. Pick an exe, msi, bat or cmd file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Windows 程序。请选择 exe、msi、bat 或 cmd 文件。"
          }
        }
      }
    },
    "%@ is not a supported build. Supported: %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持构建版本 %@。支持的版本：%@。"
          }
        }
      }
    },
    "%@ is not signed by Valve. Expected TeamIdentifier=%@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 并非由 Valve 签名。预期 TeamIdentifier=%@。"
          }
        }
      }
    },
    "%@ is not the Steam bundle. Expected Identifier=%@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam 应用包。预期 Identifier=%@。"
          }
        }
      }
    },
    "%@ is not there, so there is nothing to install into." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在，无法安装。"
          }
        }
      }
    },
    "%@ is running. Quit the game first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行。请先退出游戏。"
          }
        }
      }
    },
    "%@ names the package %@, which is not declared. Declared: %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 指定了未声明的软件包 %@。已声明：%@。"
          }
        }
      }
    },
    "%@ templates %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 模板 %@"
          }
        }
      }
    },
    "%@ was last run by %@, which is no longer set up. Rebuild the prefix first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上次使用 %@ 运行，但该兼容工具已不可用。请先重建游戏容器。"
          }
        }
      }
    },
