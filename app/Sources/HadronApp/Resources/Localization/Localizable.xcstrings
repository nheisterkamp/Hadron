        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此软件包的文件需要手动下载，Hadron 无法代劳。"
          }
        }
      }
    },
    "This tool is intended to repair a prefix after its compatibility tool changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Tool repariert ein Präfix, nachdem sich sein Kompatibilitätstool geändert hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet outil sert à réparer un préfixe après un changement de son outil de compatibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo strumento serve a riparare un prefisso dopo che il suo strumento di compatibilità è cambiato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具用于修复更换兼容工具后的游戏容器。"
          }
        }
      }
    },
    "This will DELETE the game's prefix." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird das Präfix des Spiels GELÖSCHT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le préfixe du jeu sera SUPPRIMÉ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prefisso del gioco verrà ELIMINATO."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将删除该游戏的容器。"
          }
        }
      }
    },
    "This will DELETE the prefixes for %lld games." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Präfixe von %lld Spielen GELÖSCHT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préfixes de %lld jeux seront SUPPRIMÉS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prefissi di %lld giochi verranno ELIMINATI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将删除 %lld 个游戏的容器。"
          }
        }
      }
    },
    "This will restore Steam itself to its original state but does not remove the support components used by Hadron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird Steam selbst in den Originalzustand zurückversetzt, die von Hadron verwendeten Hilfskomponenten werden aber nicht entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam lui-même sera restauré dans son état d'origine, mais les composants de support utilisés par Hadron ne seront pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam verrà riportato allo stato originale, ma i componenti di supporto usati da Hadron non verranno rimossi."
