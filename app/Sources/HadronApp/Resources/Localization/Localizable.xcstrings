          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron 已移除。"
          }
        }
      }
    },
    "Hadron has been removed. Steam could not be restored. Reinstall Steam from steampowered.com before using it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron wurde entfernt. Steam konnte nicht wiederhergestellt werden. Installiere Steam von steampowered.com neu, bevor du es wieder verwendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadron a été supprimé. Steam n'a pas pu être restauré. Réinstallez Steam depuis steampowered.com avant de l'utiliser à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
